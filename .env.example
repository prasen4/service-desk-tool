# Required: your LLM provider API key
OPENAI_API_KEY=sk-your-key-here

# Provider: openai | anthropic | azure_openai | google | xai | mistral | openai_compatible
LLM_PROVIDER=openai

# Base URL + model. For non-OpenAI providers the app fills sensible defaults,
# but you can override here. Examples:
#   OpenAI     -> https://api.openai.com/v1              model: gpt-4o
#   Anthropic  -> https://api.anthropic.com              model: claude-sonnet-4-20250514
#   Google     -> https://generativelanguage.googleapis.com/v1beta/openai/  model: gemini-2.5-pro
#   xAI        -> https://api.x.ai/v1                    model: grok-4
#   Mistral    -> https://api.mistral.ai/v1              model: mistral-large-latest
#   Azure OpenAI -> https://<your-resource>.openai.azure.com/  model: <your-deployment-name>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Azure OpenAI (enterprise) only: API version for the Azure resource. Only
# used when LLM_PROVIDER=azure_openai (OPENAI_BASE_URL is your Azure endpoint
# and OPENAI_MODEL is your deployment name in that case).
AZURE_OPENAI_API_VERSION=2024-10-21

# Application
ENV=development
TECH_DESK_DATA_DIR=./data
TECH_DESK_HOST=0.0.0.0
TECH_DESK_PORT=8080
TECH_DESK_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Database
# Leave DATABASE_URL empty to use the local SQLite file in TECH_DESK_DATA_DIR
# (the zero-config default). For multiple concurrent writers/users, point at
# PostgreSQL and install the driver with:  pip install -e ".[postgres]"
#   DATABASE_URL=postgresql+psycopg://techdesk:password@localhost:5432/techdesk
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Performance — images fetched at report time only (fast research)
IMAGE_FETCH_ENABLED=true
IMAGE_FETCH_DURING_RESEARCH=false
IMAGE_FETCH_TIMEOUT=3.0

# Automated scheduling (daily 6am, weekly Mon 7am, monthly 1st 8am UTC)
SCHEDULER_ENABLED=false

# Research tuning
RESEARCH_MAX_RESULTS_PER_QUERY=8
RESEARCH_LOOKBACK_DAYS=30
PRIORITY_DESK_DEPTH_MULTIPLIER=2

# Optional: SharePoint export
# SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/TechDesk
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_TENANT_ID=
